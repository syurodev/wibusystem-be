# =============================================================================
# WibuSystem Backend - Production Environment Variables
# Copy to .env và cập nhật các giá trị
# =============================================================================

# Docker Image (được set tự động bởi GitHub Actions)
DOCKER_IMAGE=your-dockerhub-username/wibusystem-be:latest

# Server
ENVIRONMENT=production
SERVER_PORT=8080

# PostgreSQL
DB_NAME=wibusystem
DB_USER=wibusystem
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ClickHouse
CLICKHOUSE_DATABASE=wibusystem
CLICKHOUSE_USER=wibusystem
CLICKHOUSE_PASSWORD=CHANGE_ME_STRONG_CLICKHOUSE_PASSWORD

# OAuth2
OAUTH2_ISSUER=https://api.wibutime.io.vn
OAUTH2_HMAC_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG_SECRET

# CORS - domains được phép gọi API
CORS_ALLOW_ORIGINS=https://wibutime.io.vn,https://www.wibutime.io.vn

# Email (Resend)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM_EMAIL=noreply@wibutime.io.vn
EMAIL_FROM_NAME=WibuTime
EMAIL_BASE_URL=https://wibutime.io.vn

# WebAuthn / Passkey
WEBAUTHN_RP_ID=wibutime.io.vn
WEBAUTHN_RP_NAME=WibuTime
WEBAUTHN_RP_ORIGINS=https://wibutime.io.vn,https://www.wibutime.io.vn

# Logging
LOG_LEVEL=info

# Grafana (optional)
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
