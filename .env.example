# =============================================================================
# WibuSystem Modular Monolith - Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_GRPC_PORT=50051
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
ENVIRONMENT=development

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=system_dev
DB_USER=system_dev
DB_PASSWORD=system_dev
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_MIGRATIONS_PATH=./migrations

# Database Schemas (for each module)
DB_IDENTITY_SCHEMA=identity
DB_CATALOG_SCHEMA=catalog
DB_COMMUNITY_SCHEMA=community
DB_PAYMENT_SCHEMA=payment

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=8767375c91873d04626c73c8aed8ce01
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONN=2

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
BCRYPT_COST=12
JWT_SECRET=development-secret-change-in-production-with-long-random-string
SESSION_DURATION=24h

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=Origin,Content-Type,Authorization,Accept-Language
CORS_EXPOSE_HEADERS=Content-Length
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=43200

# =============================================================================
# LOCALIZATION (i18n)
# =============================================================================
I18N_DEFAULT_LANGUAGE=en
I18N_SUPPORTED_LANGUAGES=en,vi,ja
I18N_BUNDLE_PATH=./locales
I18N_QUERY_PARAM=lang
I18N_HEADER_NAME=Accept-Language
I18N_COOKIE_NAME=locale

# =============================================================================
# IDENTITY MODULE CONFIGURATION
# =============================================================================

# OAuth2/OIDC Configuration
OAUTH2_ISSUER=http://localhost:8080
OAUTH2_ACCESS_TOKEN_LIFESPAN=1h
OAUTH2_REFRESH_TOKEN_LIFESPAN=720h
OAUTH2_AUTHORIZE_CODE_LIFESPAN=10m
OAUTH2_ID_TOKEN_LIFESPAN=1h
OAUTH2_JWT_SIGNING_KEY=
OAUTH2_ALLOW_INSECURE_ENDPOINTS=true

# Identity Module Secrets
IDENTITY_REG_ACCESS_TOKEN_SECRET=change-this-secret-in-production-for-registration-tokens
IDENTITY_INITIAL_ACCESS_TOKEN=
IDENTITY_LOGIN_PAGE_URL=http://localhost:3000/login

# =============================================================================
# CATALOG MODULE CONFIGURATION
# =============================================================================
CATALOG_ENABLE_ANIME=true
CATALOG_ENABLE_MANGA=true
CATALOG_ENABLE_NOVEL=true
CATALOG_CDN_BASE_URL=
CATALOG_IMAGE_PROXY_URL=
CATALOG_SIGNED_URL_EXPIRY=1h

# =============================================================================
# DEVELOPMENT / DEBUGGING
# =============================================================================
# Set to "debug" for verbose logging
LOG_LEVEL=info

# Enable SQL query logging (for debugging)
DB_LOG_QUERIES=false

# Enable profiling endpoints (/debug/pprof/*)
ENABLE_PROFILING=false
